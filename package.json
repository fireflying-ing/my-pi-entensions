{
  "name": "my-pi-entensions",
  "version": "1.0.0",
  "description": "Pi extension: route the bash tool to a remote host over SSH",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "ssh",
    "remote"
  ],
  "author": "",
  "license": "ISC",
  "pi": {
    "extensions": ["./extensions/ssh-exec.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
